# BAT POD Configuration Template

# System Run Mode: "mock" (simulation) or "hardware" (real Arduino/ESP32 UART)
BAT_POD_MODE=mock

# Serial Hardware Configuration (Used in "hardware" mode)
ARDUINO_PORT=COM3
ARDUINO_BAUD=115200
ESP32_PORT=COM4
ESP32_BAUD=115200
SERIAL_TIMEOUT_SEC=2.0

# Database Storage
SQLITE_DB_PATH=data/bat_pod.db

# Safety & Sensor Thresholds
SENSOR_POLL_INTERVAL_SEC=1.0
GAS_CRITICAL_THRESHOLD_PPM=300.0
GAS_WARNING_THRESHOLD_PPM=150.0
TEMP_CRITICAL_HIGH_C=50.0
TEMP_WARNING_HIGH_C=38.0
SOIL_DRY_THRESHOLD_PCT=25.0

# Human-in-the-Loop Settings
APPROVAL_TIMEOUT_SEC=30.0

# AI & Voice Pipeline Configuration
# Options: "local" (built-in rule & fallback), "sarvam" (Sarvam API), "ollama" (local LLM)
AI_BACKEND=local
SARVAM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
VOICE_LANGUAGE=en-IN

# Logging
LOG_LEVEL=INFO
